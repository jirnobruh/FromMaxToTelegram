# ========================================================
# MAX Messenger Configuration
# ========================================================
MAX_TOKEN=your_max_token_here
MAX_CHAT_IDS=12345678,87654321

# ========================================================
# Telegram Bot Configuration
# ========================================================
TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TG_CHAT_ID=-1001234567890
TG_TOPIC_ID=123

# Опционально: ручное переопределение названий чатов (если не нужно использовать оригинальное из MAX)
# CHAT_NAMES={"12345678": "Рабочий чат", "87654321": "Флудилка"}
# CHAT_MAPPING={"12345678": {"tg_chat_id": -1001234567890, "tg_topic_id": 123, "chat_name": "Рабочий чат"}}

# ========================================================
# Application Settings
# ========================================================
LOG_LEVEL=INFO
LOGS_DIR=logs
MAX_LOGS_DIR_SIZE_MB=1024
MAX_LOG_FILE_SIZE_MB=100
